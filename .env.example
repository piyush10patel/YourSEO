# Copy to .env and adjust as needed. All vars are prefixed with SEO_.

SEO_APP_NAME="AI SEO Agent"
SEO_DEBUG=false

# HTTP / scraper
SEO_REQUEST_TIMEOUT=15
SEO_MAX_CONTENT_BYTES=5000000
# SEO_USER_AGENT="Mozilla/5.0 (...)"   # override the default browser UA

# Retry / exponential backoff
SEO_MAX_RETRIES=4
SEO_BACKOFF_INITIAL=1.0
SEO_BACKOFF_MAX=30.0
SEO_BACKOFF_MULTIPLIER=2.0

# Ollama / LLM
SEO_OLLAMA_BASE_URL=http://localhost:11434
SEO_OLLAMA_MODEL=llama3.2:3b
SEO_OLLAMA_TIMEOUT=120
SEO_OLLAMA_MAX_RETRIES=2

# Agent (ReAct loop)
SEO_AGENT_MAX_STEPS=8
SEO_AGENT_TEMPERATURE=0.1

# Caching: backend = sqlite | redis | none
SEO_CACHE_BACKEND=sqlite
SEO_CACHE_TTL_SECONDS=86400
SEO_CACHE_PATH=audit_cache.sqlite3
SEO_REDIS_URL=redis://localhost:6379/0

# API base URL (used by the UI when calling the API over HTTP)
SEO_API_URL=http://localhost:8000

# Auth (Clerk) — leave blank for self-hosted dev mode (header-based role/org).
# Set the JWKS URL to verify Clerk session JWTs (Bearer tokens).
SEO_CLERK_JWKS_URL=
SEO_CLERK_ISSUER=

# Billing (Stripe) — leave blank to disable billing (free plan, no limits).
SEO_STRIPE_SECRET_KEY=
SEO_STRIPE_WEBHOOK_SECRET=
SEO_STRIPE_PRICE_PRO=
SEO_FREE_PLAN_MAX_PROJECTS=3
